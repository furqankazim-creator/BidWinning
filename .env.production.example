# Copy to .env.production.local on the website host. Never commit the real file.
# Public address of the API (https), baked into the website at build time:
NEXT_PUBLIC_API_URL=https://YOUR-API-DOMAIN
# Address the website server uses to reach the standards/OCR API:
STANDARDS_API_URL=https://YOUR-API-DOMAIN
# Same value as INTERNAL_API_KEY in server/.env:
INTERNAL_API_KEY=
# AI provider (at least one):
GROQ_API_KEYS=
ANTHROPIC_API_KEY=
