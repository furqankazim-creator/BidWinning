    "test:all": "npm run test:lifecycle && npm run api:test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.3",
    "next": "^15.3.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
