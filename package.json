{
  "name": "bidwinning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api": "npm --prefix server run dev",
    "api:test": "npm --prefix server test",
    "dev:full": "concurrently -k \"npm run api\" \"NEXT_PUBLIC_API_URL=http://localhost:4005 next dev\"",
    "test:lifecycle": "tsx --tsconfig tsconfig.json tests/lifecycle.mts",
    "test:all": "npm run check:codes && npm run test:lifecycle && npm run test:verified && npm run test:xlsx && npm run test:takeoff && npm run api:test",
    "check:codes": "diff server/src/codes.ts src/lib/server/verified/codes.ts && echo 'codes.ts copies are identical'",
    "test:verified": "tsx --tsconfig tsconfig.json tests/verified.mts",
    "test:xlsx": "tsx --tsconfig tsconfig.json tests/xlsx-extract.mts",
    "test:takeoff": "tsx --tsconfig tsconfig.json tests/takeoff.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.3",
    "next": "^15.3.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "1.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
