{
  "name": "bidwinning-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "cross-env USE_MEMORY_DB=1 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "cross-env ALLOW_OPEN_SIGNUP=1 USE_MEMORY_DB=1 INTERNAL_API_KEY=smoke-test-key DISABLE_RATE_LIMIT=1 PORT=4999 tsx src/smoke.ts",
    "seed:demo": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.22.3",
    "@napi-rs/canvas": "1.0.9",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/multer": "^2.3.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22",
    "mongodb-memory-server": "^10.1.3",
