# Copy to server/.env on the production host. Never commit the real file.
NODE_ENV=production
PORT=4005
# Managed MongoDB with a username and password (e.g. Atlas), not a local database:
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR-CLUSTER.mongodb.net/bidwinning?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Only your real website address, https only (comma-separate several):
CORS_ORIGIN=https://YOUR-DOMAIN
# The one and only Super Admin (created on first start). Use a strong password, 12+ characters:
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
# Used between the website server and this API; generate another random value:
INTERNAL_API_KEY=
