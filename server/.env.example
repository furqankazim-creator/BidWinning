PORT=4005
# Local MongoDB (MongoDB Compass: connect to the same string):
# MONGODB_URI=mongodb://127.0.0.1:27017/bidwinning
# Hosted (Atlas):
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vendoriq?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app
# set USE_MEMORY_DB=1 to run with an in-memory MongoDB (no install needed) for local dev/tests

# dev only: set to 1 to let requests without a token act as a built-in Super Admin (off by default)
# DEV_AUTH_BYPASS=1

# Platform Super Admin, created on first API start:
# SUPER_ADMIN_EMAIL=superadmin@bidwinning.local
# SUPER_ADMIN_PASSWORD=choose-a-strong-password
