# Copy to .env.local (gitignored). Agent chat picks the first configured provider:
# 1) Anthropic (preferred): claude-opus-5 via the official SDK
ANTHROPIC_API_KEY=
# 2) Groq fallback (OpenAI-compatible): free tier, model overridable
GROQ_API_KEY=
# or a pool — automatic failover to the next key on rate limit (429) / rejection
GROQ_API_KEYS=gsk_first,gsk_second
GROQ_MODEL=openai/gpt-oss-120b
